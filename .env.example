# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (no trailing slash).
APP_URL="MY_APP_URL"

# Google OAuth 2.0 Web Client Credentials (same Web Client ID on frontend & backend)
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://your-domain.vercel.app/api/auth/google/callback"

# Security & Session Secrets (generate strong random strings >= 32 chars via `openssl rand -base64 32`)
SESSION_SECRET="CHANGE_ME_MIN_32_CHARS_RANDOM_SESSION_SECRET"
TOKEN_ENCRYPTION_KEY="CHANGE_ME_MIN_32_CHARS_RANDOM_ENCRYPTION_KEY"

# Persistent PostgreSQL Database URL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
