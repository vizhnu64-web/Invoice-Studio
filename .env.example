# ============================================================
# INVOICE STUDIO — PUBLIC USER-OWNED GOOGLE OAUTH CONFIGURATION
# ============================================================
# Architecture:
# - Public web app (no Invoice Studio accounts, no database, no service account).
# - Google Identity Services (GIS) OAuth 2.0 token model with backend token verification.
# - Access tokens stay strictly in JavaScript module memory (never localStorage/DB).
# - Each business connects its own Google account for:
#     1. Google Drive (permanent per-business workspace storage)
#     2. Google Sheets (spreadsheet importing)
#     3. Gmail API (optional incremental gmail.send permission for invoice/quotation emailing)
#
# Google Cloud Console OAuth 2.0 Web Client Setup:
# - Authorized JavaScript origins:
#     https://invoice-studio-six-drab.vercel.app
#     http://localhost:5173
#     http://localhost:3000
# - Required APIs enabled in Google Cloud Console:
#     Google Drive API, Google Sheets API, Gmail API, Google Picker API

# Public Google OAuth Web Client ID (also readable server-side as GOOGLE_CLIENT_ID for audience checks)
VITE_GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"

# Public Google Browser API Key (restricted to HTTP referrers & Picker API)
VITE_GOOGLE_API_KEY="your-browser-api-key"

# Google Cloud Project Number (App ID for Google Picker)
VITE_GOOGLE_APP_ID="123456789012"

# Optional server-side alias for token audience validation (defaults to VITE_GOOGLE_CLIENT_ID if omitted)
# GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"

# Server-side AES-256-GCM key (32+ random characters) used ONLY to encrypt optional
# per-business Custom SMTP passwords before storing inside each user's own Drive workspace/email-settings.json.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_ENCRYPTION_KEY="replace-with-a-random-32-plus-char-secret-key"

# Public deployed application URL
APP_URL="https://invoice-studio-six-drab.vercel.app"
