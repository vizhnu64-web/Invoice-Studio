# Invoice Studio — Server-Side Environment Variables (No User Sign-In Architecture)
# Never prefix private keys or secrets with VITE_ and never expose them to frontend code.

# Public application URL (no trailing slash)
APP_URL="https://your-domain.vercel.app"

# Centrally Configured Google Service Account (for private Google Drive & Google Sheets)
GOOGLE_SERVICE_ACCOUNT_EMAIL="invoice-studio@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID="your-gcp-project-id"

# Server-Side AES-256-GCM Encryption Key for SMTP Passwords (min 32 random chars: `openssl rand -base64 32`)
SMTP_ENCRYPTION_KEY="CHANGE_ME_MIN_32_CHARS_RANDOM_SMTP_ENCRYPTION_KEY"
